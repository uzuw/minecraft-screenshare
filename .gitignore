# ---------------------------------------------------------------------------
# Derived Mojang artifacts: copyrighted, large, and reproducible from the tools.
#   unsigned/<v>-unsigned.jar    -> python3 tools/unsign_jar.py
#   notes/decompiled/**          -> bash tools/decompile_class.sh <fqcn>
#   patched/src/net/minecraft/** -> python3 screenshare/patch_*.py (run by build.sh)
#   patched/out/**               -> bash screenshare/build.sh
# ---------------------------------------------------------------------------
unsigned/
notes/decompiled/
patched/src/net/minecraft/
patched/out/

# The MCP-Reborn / Gradle base this work layers onto. Deliberately not part of this repo:
# it is a separate clone, and this directory is meant to sit inside it (or beside the game
# install with MC_ROOT set).
build.gradle
settings.gradle
gradle.properties
gradlew
gradlew.bat
gradle/
.gradle/
.github/
MCP-License
